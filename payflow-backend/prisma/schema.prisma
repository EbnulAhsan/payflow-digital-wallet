generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
  CUSTOMER
  MERCHANT

  @@map("user_role")
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED

  @@map("user_status")
}

model User {
  id            BigInt         @id @default(autoincrement())
  fullName      String         @map("full_name") @db.VarChar(120)
  mobile        String         @unique @db.Char(11)
  email         String         @unique @db.VarChar(254)
  passwordHash  String         @map("password_hash")
  role          UserRole
  status        UserStatus     @default(PENDING)
  mustResetPw   Boolean        @default(false) @map("must_reset_pw")
  failedLogins  Int            @default(0) @map("failed_logins") @db.SmallInt
  lockedUntil   DateTime?      @map("locked_until") @db.Timestamptz(6)
  statusReason  String?        @map("status_reason") @db.VarChar(255)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  refreshTokens RefreshToken[]
  loginFailures LoginFailure[]
  wallet        Wallet?

  @@map("users")
}

enum WalletKind {
  USER
  TREASURY

  @@map("wallet_kind")
}

enum CashoutStatus {
  PENDING_AUTHORIZATION
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED

  @@map("co_status")
}

// Mirrors migrations/001_initial_schema.up.sql; the SQL migrations remain the
// source of truth for constraints, indexes and grants.
model Wallet {
  id        BigInt     @id @default(autoincrement())
  userId    BigInt?    @unique @map("user_id")
  kind      WalletKind @default(USER)
  balance   Decimal    @default(0) @db.Decimal(14, 2)
  version   Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?      @relation(fields: [userId], references: [id])

  @@map("wallets")
}

model CashoutRequest {
  id            BigInt        @id @default(autoincrement())
  agentId       BigInt        @map("agent_id")
  customerId    BigInt        @map("customer_id")
  amount        Decimal       @db.Decimal(14, 2)
  status        CashoutStatus @default(PENDING_AUTHORIZATION)
  transactionId BigInt?       @unique @map("transaction_id")
  expiresAt     DateTime      @map("expires_at") @db.Timestamptz(6)
  decidedAt     DateTime?     @map("decided_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("cashout_requests")
}

// Append-only (BR-11): the application role has no UPDATE or DELETE grant.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    BigInt?  @map("actor_id")
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   BigInt   @map("entity_id")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ipAddress  String?  @map("ip_address") @db.Inet
  requestId  String   @map("request_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt(sort: Desc)], map: "audit_entity")
  @@map("audit_logs")
}

model LoginFailure {
  id       BigInt   @id @default(autoincrement())
  userId   BigInt   @map("user_id")
  failedAt DateTime @default(now()) @map("failed_at") @db.Timestamptz(6)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, failedAt])
  @@map("login_failures")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id])

  @@index([familyId])
  @@map("refresh_tokens")
}
