# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://payflow_app:password@localhost:5432/payflow?schema=public"

# Auth & Tokens (SRS NFR-SEC-02: HS256 >= 32 bytes)
JWT_SECRET="payflow_jwt_secret_min_32_chars_long_key_demo"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS
CLIENT_URL="http://localhost:5173"