# Application
PORT=3000
NODE_ENV=development

# PostgreSQL 16 (created by the project migrations)
# On Vercel use the pooled Neon string with the payflow_app role and
# ?sslmode=require&pgbouncer=true&connect_timeout=15
DATABASE_URL=postgresql://payflow_app:payflow_app_dev_password@localhost:5432/payflow_db?schema=public

# Direct (not pooled) connection of the database owner. Used only by
# `npm run migrate` and `npm run seed`, never by the running app.
DIRECT_URL=postgresql://payflow_admin:replace_me@localhost:5432/payflow_db

# Password to set on the payflow_app role when migrating (staging and production)
APP_DB_PASSWORD=replace_with_a_strong_password

# Password for every demo user when running `npm run seed` (staging only)
SEED_USER_PASSWORD=replace_with_a_demo_password

# HS256 access-token secret; use a random value of at least 32 bytes
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_bytes

# CORS
CLIENT_URL=http://localhost:5173