{
  "rewrites": [
    {
      "source": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "payflow-digital-wallet-web-staging.vercel.app"
        }
      ],
      "destination": "https://payflow-digital-wallet-api-staging.vercel.app/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://payflow-api-two.vercel.app/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}